{
  "name": "pi-commandcode-provider",
  "version": "0.1.0",
  "description": "Pi extension that adds Command Code (commandcode.ai) as a model provider. Routes requests through the same endpoint Command Code's own CLI uses, so the provider works on the Go plan without Pro-tier API access.",
