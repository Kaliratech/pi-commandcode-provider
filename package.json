    "pi",
    "pi-package",
    "pi-extension",
    "commandcode",
    "deepseek",
    "kimi",
    "qwen",
    "glm",
    "minimax",
    "mimo"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Safzan Pirani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safzanpirani/pi-commandcode-provider.git"
  },
  "homepage": "https://github.com/safzanpirani/pi-commandcode-provider#readme",
  "bugs": {
    "url": "https://github.com/safzanpirani/pi-commandcode-provider/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "echo 'nothing to check'"
  }
}
